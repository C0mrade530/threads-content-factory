{
  "openapi": "3.1.0",
  "info": {
    "title": "Threads контент завод",
    "description": "Один владелец на экземпляр. Интервью → профиль → аккаунт → расписание → публикации.",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "https://threads.example.com"
    }
  ],
  "paths": {
    "/status": {
      "get": {
        "summary": "Status",
        "description": "Прочитать профиль, частоту, подключённый аккаунт и очередь. Без секретов.",
        "operationId": "getFactoryStatus",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/profile": {
      "put": {
        "summary": "Profile",
        "description": "Сохранить ответы интервью. Неотправленные слоты отменяются, тексты остаются в истории.",
        "operationId": "saveNicheProfile",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Profile"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/connection/start": {
      "post": {
        "summary": "Connection Start",
        "description": "Получить одноразовую ссылку подключения Threads. Человек входит на стороне провайдера.",
        "operationId": "startThreadsConnection",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/connection": {
      "get": {
        "summary": "Connection",
        "description": "Показать действительное имя и идентификатор подключённого аккаунта.",
        "operationId": "checkThreadsConnection",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/connection/bind": {
      "post": {
        "summary": "Bind",
        "description": "Привязать только показанный и подтверждённый человеком аккаунт.",
        "operationId": "confirmThreadsAccount",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Binding"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "x-openai-isConsequential": true
      }
    },
    "/schedule": {
      "put": {
        "summary": "Schedule",
        "description": "Из чата задать постов в день, часовой пояс и время. Автогенерация — отдельное явное согласие.",
        "operationId": "configurePublishingSchedule",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScheduleChange"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "x-openai-isConsequential": true
      }
    },
    "/pause": {
      "post": {
        "summary": "Pause",
        "description": "Остановить новые отправки и отменить ещё не отправленные слоты. Тексты сохраняются.",
        "operationId": "pausePublishing",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/queue": {
      "post": {
        "summary": "Queue",
        "description": "Поставить утверждённые тексты в ближайшие свободные слоты. request_id защищает от дубля пакета.",
        "operationId": "queueApprovedPosts",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Batch"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "x-openai-isConsequential": true
      }
    },
    "/references": {
      "get": {
        "summary": "References",
        "description": "Взять авторские объяснения механик из базы для оригинальной адаптации к нише.",
        "operationId": "getReferenceExamples",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 63,
              "minimum": 0,
              "default": 0,
              "title": "Offset"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 5,
              "minimum": 1,
              "default": 3,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Batch": {
        "properties": {
          "request_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{8,100}$",
            "title": "Request Id"
          },
          "posts": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 50,
            "minItems": 1,
            "title": "Posts"
          },
          "approved": {
            "type": "boolean",
            "title": "Approved"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "posts",
          "approved"
        ],
        "title": "Batch"
      },
      "Binding": {
        "properties": {
          "confirmed": {
            "type": "boolean",
            "title": "Confirmed"
          },
          "account_id": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Account Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "confirmed",
          "account_id"
        ],
        "title": "Binding"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Profile": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Name"
          },
          "niche": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 3,
            "title": "Niche"
          },
          "audience": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 3,
            "title": "Audience"
          },
          "offer": {
            "type": "string",
            "maxLength": 1500,
            "title": "Offer",
            "default": ""
          },
          "goal": {
            "type": "string",
            "maxLength": 1000,
            "title": "Goal",
            "default": "Полезные посты и узнаваемость"
          },
          "voice": {
            "type": "string",
            "maxLength": 1500,
            "title": "Voice",
            "default": "Разговорно, конкретно, без канцелярита"
          },
          "facts": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 50,
            "title": "Facts"
          },
          "topics": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 30,
            "minItems": 1,
            "title": "Topics"
          },
          "forbidden": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 30,
            "title": "Forbidden"
          },
          "cta": {
            "type": "string",
            "maxLength": 500,
            "title": "Cta",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "niche",
          "audience",
          "topics"
        ],
        "title": "Profile"
      },
      "ScheduleChange": {
        "properties": {
          "enabled": {
            "type": "boolean",
            "title": "Enabled",
            "default": false
          },
          "posts_per_day": {
            "type": "integer",
            "maximum": 24.0,
            "minimum": 1.0,
            "title": "Posts Per Day",
            "default": 3
          },
          "timezone": {
            "type": "string",
            "title": "Timezone",
            "default": "Europe/Moscow"
          },
          "times": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 24,
            "title": "Times"
          },
          "autonomous_generation": {
            "type": "boolean",
            "title": "Autonomous Generation",
            "default": false
          },
          "confirmed": {
            "type": "boolean",
            "title": "Confirmed",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "ScheduleChange"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
